{
  "$schema": "https://json.schemastore.org/package.json",
  "type": "module",
  "version": "1.1.0",
  "name": "i-thinking",
  "private": true,
  "scripts": {
    "build": "turbo run build --filter=!@i-thinking/client",
    "build:client": "turbo run build --filter=@i-thinking/client",
    "build:composables": "turbo run build --filter=@i-thinking/composables",
    "build:studio": "turbo run build --filter=@i-thinking/studio",
    "build:devtools": "turbo run build --filter=@i-thinking/devtools",
    "build:directives": "turbo run build --filter=@i-thinking/directives",
    "build:extension": "turbo run build --filter=@i-thinking/extension",
    "build:hooks": "turbo run build --filter=@i-thinking/hooks",
    "build:utils": "turbo run build --filter=@i-thinking/utils",
    "bump:client": "pnpm --filter @i-thinking/client exec bumpp --configFilePath bump.client.ts",
    "bump:devtools": "pnpm --filter @i-thinking/devtools exec bumpp --configFilePath bump.devtools.ts",
    "bump:extension": "pnpm --filter @i-thinking/extension exec bumpp --configFilePath bump.extension.ts",
    "bump:studio": "pnpm --filter @i-thinking/studio exec bumpp --configFilePath bump.studio.ts",
    "command": "node scripts/commands/index.ts",
    "sidecar": "node scripts/commands/index.ts sidecar",
    "distribution": "node scripts/commands/index.ts distribution",
    "check:vscode": "node scripts/infra/vscode-settings.ts --check",
    "check:scripts": "tsc -p scripts/tsconfig.json",
    "sync:vscode": "node scripts/infra/vscode-settings.ts",
    "coverage": "turbo run coverage --filter=!@i-thinking/client",
    "dev": "turbo run dev --filter=!@i-thinking/client",
    "dev:client": "turbo run dev --filter=@i-thinking/client",
    "dev:studio": "turbo run dev --filter=@i-thinking/studio",
    "dev:devtools": "turbo run dev --filter=@i-thinking/devtools",
    "dev:extension": "turbo run dev --filter=@i-thinking/extension",
    "e2e": "turbo run e2e --filter=!@i-thinking/client",
    "format": "prettier --write \"**/*.{ts,tsx,vue,json,scss,md}\"",
    "lint": "turbo run lint --filter=!@i-thinking/client",
    "preinstall": "npx --yes only-allow pnpm",
    "prepare": "run-s prepare:husky",
    "prepare:husky": "husky",
    "prepare:manager": "npx only-allow pnpm",
    "preview": "turbo run preview --filter=!@i-thinking/client",
    "preview:client": "turbo run preview --filter=@i-thinking/client",
    "preview:extension": "turbo run preview --filter=@i-thinking/extension",
    "report": "playwright show-report apps/extension/playwright-report",
    "report:extension": "pnpm --filter=@i-thinking/extension exec playwright show-report",
    "unit": "turbo run unit --filter=!@i-thinking/client"
  },
