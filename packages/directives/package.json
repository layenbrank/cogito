{
  "name": "@cogito/directives",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "scripts": {
    "build": "rolldown -c",
    "dev": "vite",
    "format": "prettier --write src/",
    "lint": "run-s lint:*",
