{
  "name": "@cogito/design",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "cogito 设计系统：shadcn/ui 原子组件 + assistant-ui elements + 设计 token",
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "run-s lint:*",
    "lint:eslint": "eslint . --fix",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "format": "prettier --write src/",
    "registry:add": "shadcn add",
    "test:unit": "vitest",
    "unit": "vitest run",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@assistant-ui/react": "catalog:",
    "@assistant-ui/react-markdown": "catalog:",
    "@assistant-ui/react-o11y": "catalog:",
    "@base-ui/react": "catalog:",
    "@iconify/react": "catalog:",
    "@types/d3": "^7.4.3",
    "@xyflow/react": "^12.12.0",
    "ansi-to-react": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "^1.1.1",
    "cn": "catalog:",
    "d3": "^7.9.0",
    "dayjs": "catalog:",
    "heat-graph": "catalog:",
    "lodash-es": "^4.17.21",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "remark-gfm": "catalog:",
    "shiki": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:",
    "tw-shimmer": "catalog:",
    "use-stick-to-bottom": "^1.1.6",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "imports": {
    "#components/date-picker": "./src/components/date-picker/index.tsx",
    "#components/date-picker/*": "./src/components/date-picker/*",
    "#components/charts": "./src/components/charts/index.tsx",
    "#components/charts/*": "./src/components/charts/*",
    "#components/splitter": "./src/components/splitter/index.tsx",
    "#components/splitter/*": "./src/components/splitter/*",
    "#components/*": "./src/components/*.tsx",
    "#assistant/*": "./src/assistant/*.tsx",
    "#assistant/web-search-state": "./src/assistant/web-search-state.ts",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./components/date-picker": "./src/components/date-picker/index.tsx",
    "./components/date-picker/*": "./src/components/date-picker/*",
    "./components/charts": "./src/components/charts/index.tsx",
    "./components/charts/*": "./src/components/charts/*",
    "./components/splitter": "./src/components/splitter/index.tsx",
    "./components/splitter/*": "./src/components/splitter/*",
    "./components/*": "./src/components/*.tsx",
    "./assistant/*": "./src/assistant/*.tsx",
    "./assistant/web-search-state": "./src/assistant/web-search-state.ts",
    "./assistant/prompt-vars": "./src/assistant/prompt-vars.ts",
    "./assistant/tool-call-state": "./src/assistant/tool-call-state.ts",
    "./assistant/thread-day": "./src/assistant/thread-day.ts",
    "./assistant/message-time": "./src/assistant/message-time.ts",
    "./assistant/process-state": "./src/assistant/process-state.ts",
    "./assistant/tool-timeline-state": "./src/assistant/tool-timeline-state.ts",
    "./assistant/file-change-tree-state": "./src/assistant/file-change-tree-state.ts",
    "./assistant/agent-plan-state": "./src/assistant/agent-plan-state.ts",
    "./assistant/job-progress-state": "./src/assistant/job-progress-state.ts",
    "./assistant/timeline-state": "./src/assistant/timeline-state.ts",
    "./assistant/approval-card-state": "./src/assistant/approval-card-state.ts",
    "./assistant/mcp-config-state": "./src/assistant/mcp-config-state.ts",
    "./assistant/retrieval-chunks-state": "./src/assistant/retrieval-chunks-state.ts",
    "./assistant/tool-row": "./src/assistant/tool-row.ts",
    "./assistant/composer-document": "./src/assistant/composer-document.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts"
  }
}
