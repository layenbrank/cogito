# 开发 compose 插值（${VAR}）。不入库。完整说明：guide/deployment.md §2
#
#   cp .env.example .env

# 必填（无默认值，缺则 compose 报错）
POSTGRES_PASSWORD=change-me-postgres-password
COMPUTE_INTERNAL_TOKEN=change-me-internal-token
SERVICE_TOKEN_SECRET=change-me-service-token-secret

# 可选
# APP_ENV=development
# COMPUTE_ENVIRONMENT=development
# TELEMETRY_ENABLED=true
# OTLP_ENDPOINT=http://jaeger:4318

# 业务 COGITO__* 写 docker/stack.env，不要写本文件。
# 生产：.env.production.example + compose.prod.yaml（guide/deployment.md §3）
