   if (openStart > 1) frag = frag.replaceChild(0, closeNodeStart(frag.firstChild, openStart - 1, frag.childCount == 1 ? openEnd - 1 : 0));
   if (openStart > 0) {
-    frag = node.type.contentMatch.fillBefore(frag).append(frag);
