{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", "tsconfig.json"],
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "CARGO_TARGET_DIR",
    "CARGO_BUILD_RUSTC_WRAPPER",
    "RUSTC_WRAPPER",
    "COREX_PDFIUM_DIR",
    "ELECTRON_MIRROR",
    "ELECTRON_CUSTOM_DIR",
    "ELECTRON_CUSTOM_FILENAME",
    "ELECTRON_GET_USE_PROXY",
    "ELECTRON_SKIP_BINARY_DOWNLOAD",
    "ELECTRON_BUILDER_BINARIES_MIRROR",
    "npm_config_electron_mirror",
    "STUDIO_UPDATE_URL",
    "STUDIO_S3_UPDATE_BASE",
    "STUDIO_UPDATE_FEED_URL",
    "TAURI_SIGNING_PRIVATE_KEY",
    "TAURI_SIGNING_PRIVATE_KEY_PATH",
    "TAURI_SIGNING_PRIVATE_KEY_PASSWORD"
  ],
  "tasks": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "vite.config.*", "rollup.config.*", "tsconfig*.json"],
      "outputLogs": "full",
      "outputs": ["dist/**", ".vitepress/dist/**", ".vite/**", "out/**"]
    },
    "coverage": {
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*.{ts,tsx,vue}",
        "**/*.{test,spec}.{ts,tsx,vue}",
        "vitest.config.*",
        "tsconfig*.json",
        ".env*"
      ],
      "outputLogs": "full",
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputLogs": "full",
      "persistent": true
    },
    "e2e": {
      "cache": false,
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "**/*.{test,spec}.ts", "playwright.config.*", ".env*"],
      "outputLogs": "full",
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "lint": {
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*.{ts,tsx,vue}",
        ".eslintrc.{js,cjs,json}",
        ".oxlintrc",
        ".prettierignore",
        ".prettierrc.{js,cjs,json}",
        "tsconfig.json",
        "vite.config.*"
      ],
      "outputLogs": "full"
    },
    "preview": {
      "cache": false,
      "dependsOn": ["build"],
      "outputLogs": "full"
    },
    "report": {
      "cache": false,
      "outputLogs": "full",
      "persistent": true
    },
    "type-check": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "src/**/*.{ts,tsx,vue}", "tsconfig*.json"],
      "outputLogs": "full"
    },
    "unit": {
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*.{ts,tsx,vue}",
        "**/*.{test,spec}.{ts,tsx,vue}",
        "vitest.config.*",
        "tsconfig*.json",
        ".env*"
      ],
      "outputLogs": "full",
      "outputs": ["coverage/**"]
    }
  }
}
