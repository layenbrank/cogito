{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "target": "ESNext",
    "module": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "isolatedModules": true,
    "resolveJsonModule": true,

    "types": [
      "vite/client",
      "node",
      "@types/react",
      "@types/react-dom",
      "@types/chrome",
      "reflect-metadata",
      "@cogito/utils",
      "@cogito/shared/response",
      "@cogito/shared/decorator",
      "@cogito/shared/constructor",
      "@cogito/shared/contextmenu",
      "@cogito/shared/user-profile",
      "@cogito/shared/schema",
      "@cogito/shared/backup",
      "@cogito/shared/mirror",
      "@cogito/shared/settings",
      "@cogito/shared/controller",
      "@cogito/shared/magnetic-tile",
      "@cogito/shared/magnetic-tile-bookmark",
      "@cogito/shared/magnetic-tile-agent",
      "@cogito/shared/process-env",
      "@electron-forge/plugin-vite/forge-vite-env"
    ],

    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"],
      // src 之外的构建期产物：路径太长，别让调用方数 '../'
      "@schema": ["./drizzle/schema"],
      "@manifest": ["./sidecar/manifest.json"]
    }
  },
  "include": ["src"],
  "exclude": ["**/node_modules/**", "**/dist/**"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
