{
  "name": "@cogito/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "build": "eas build --platform android --profile preview",
    "build:android": "eas build --platform android --profile development",
    "build:ios": "eas build --platform ios --profile development",
    "build:preview": "eas build --platform android --profile preview",
    "prod": "eas build --platform all --profile production",
    "prod:android": "eas build --platform android --profile production",
    "prod:ios": "eas build --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "update:prod": "eas update --branch production",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "unit": "jest --watchAll=false",
    "test": "jest --watchAll=false",
    "test:watch": "jest --watchAll",
    "test:ci": "jest --ci",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gluestack-ui/config": "^1.1.20",
    "@gluestack-ui/nativewind-utils": "^1.0.28",
    "@gluestack-ui/themed": "^1.1.73",
    "@hookform/resolvers": "catalog:",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "catalog:",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.4.0",
    "lucide-react-native": "^1.34.0",
    "nativewind": "4.2.6",
    "pod-install": "^1.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "catalog:",
    "react-i18next": "^17.0.12",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.6",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.33.2",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "catalog:",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "./jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!.*(?:react-native|@react-native|expo|@expo|react-navigation|@react-navigation|nativewind|react-native-css-interop|lucide-react-native|@gluestack-ui))"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "\\.png$": "<rootDir>/__mocks__/fileMock.js",
      "^lucide-react-native$": "<rootDir>/__mocks__/lucide-react-native.js",
      "^react$": "<rootDir>/../../node_modules/react",
      "^react/(.*)$": "<rootDir>/../../node_modules/react/$1"
    }
  }
}
