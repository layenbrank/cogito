# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file

root = true

[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,css,scss,sass,less,styl}]
charset = utf-8
indent_size = 2
indent_style = space
tab_width = 2
end_of_line = crlf
insert_final_newline = false
trim_trailing_whitespace = true
max_line_length = 100