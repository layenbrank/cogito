{
  "name": "@cogito/extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "run-s build:core build:post",
    "build:core": "run-p type-check \"build-only {@}\" --",
    "build:post": "node --experimental-strip-types scripts/build-suffix.ts",
    "build-only": "vite build",
    "type-check": "tsc --build",
    "preview": "vite preview",
    "smoke:dist": "node scripts/smoke-dist.ts",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix --cache",
    "lint": "run-s lint:*",
    "format": "prettier --write src/",
    "unit": "vitest",
    "e2e": "playwright test",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@iconify/react": "catalog:",
    "@iconify/json": "catalog:",
    "@tanstack/react-query": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "catalog:",
    "reflect-metadata": "catalog:"
  },
  "devDependencies": {
    "@cogito/design": "workspace:*",
    "@cogito/shared": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react-swc": "catalog:"
  }
}
