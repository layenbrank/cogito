{
  "name": "@cogito/extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "run-s build:core build:clip build:post",
    "build:core": "run-p type-check \"build-only {@}\" --",
    "build:clip": "pnpm --filter @cogito/clipper build",
    "build:post": "node --experimental-strip-types scripts/build-suffix.ts",
    "build-only": "vite build && vite build --config vite.worker.config.ts",
    "type-check": "tsc --build",
    "preview": "vite preview",
    "smoke:dist": "node scripts/smoke-dist.ts",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix --cache",
    "lint": "run-s lint:*",
    "format": "prettier --write src/",
    "unit": "vitest run",
    "e2e": "playwright test",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@cogito/design": "workspace:*",
    "@cogito/extension-kit": "workspace:*",
    "@cogito/shared": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "clsx": "catalog:",
    "dexie": "^4.4.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "catalog:",
    "reflect-metadata": "catalog:",
    "sortablejs": "^1.15.6",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/sortablejs": "^1.15.8",
    "@vitejs/plugin-react-swc": "catalog:"
  }
}
