{
  "name": "Cogito",
  "version": "0.1.0",
  "manifest_version": 3,
  "description": "新标签磁贴墙：把常去的网站、时钟和浏览器书签放在同一面墙上。",
  "minimum_chrome_version": "128",
  "permissions": ["storage", "bookmarks", "tabs", "contextMenus", "sidePanel", "favicon"],
  "host_permissions": [
    "http://127.0.0.1:19828/*",
    "http://localhost:19828/*",
    "http://127.0.0.1:19829/*",
    "http://localhost:19829/*"
  ],
  "externally_connectable": {
    "ids": ["*"]
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Cogito",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/32.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "32": "icons/32.png",
    "128": "icons/128.png"
  }
}
