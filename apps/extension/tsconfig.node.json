{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "vite.chunk.*",
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "nightwatch.conf.*",
    "playwright.config.*",
    "tailwind.config.*",
    "eslint.config.*",
    "bump.*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["postcss.config.js", "dist"],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "allowImportingTsExtensions": true,

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "@cogito/shared/process-env"],

    "rootDir": "."
  }
}
