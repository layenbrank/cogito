# cogito（Rust）镜像构建上下文 = apps/service。
#
# `.cargo/` 必须排除：仓库里那份是本机 Windows 开发配置（默认 target 为 x86_64-pc-windows-msvc、
# rustc-wrapper=sccache、Linux 段还带 crt-static/lld），带进镜像会让容器构建走错链接器与目标平台。
.cargo/
target/

# 运行时数据与生成物，不该进镜像
data/
logs/
cas/
chunks/
uploads/
.generated/
node_modules/

# 本地密钥与配置覆盖（configures/src/loader.rs 会读，但不该固化进镜像）
config.local.yaml
.env
.env.*

# compose、部署环境文件与 docker/ 资产已统一到仓库根，不在本构建上下文内。

.git/
.gitignore
.dockerignore
