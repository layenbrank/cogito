# ============================================================
# 上传模块 /api/v1/upload
# 鉴权: Bearer JWT（全路由需登录）
# 流程: signin → prepare(可无 hash) → chunk → PATCH hash → finalize → GET files / asset/{id}
# ============================================================

@host = http://127.0.0.1:3000
@username = admin
@password = 123456
@fileHash = e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

### POST /api/v1/auth/signin — 登录（必须先执行）
# @name signin
POST {{host}}/api/v1/auth/signin
Content-Type: application/json
Accept: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

###
@token = {{signin.response.body.data.token}}

### POST /api/v1/upload/prepare — 初始化上传（hash 可选）
# @name prepare
POST {{host}}/api/v1/upload/prepare
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "name": "sample.pdf",
  "size": 1048576,
  "mime": "application/pdf",
  "chunk": 1048576
}

###
@uploadId = {{prepare.response.body.data.id}}

### PATCH /api/v1/upload/hash — 绑定整文件哈希
PATCH {{host}}/api/v1/upload/hash
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "id": "{{uploadId}}",
  "hash": "{{fileHash}}"
}

### POST /api/v1/upload/chunk — 上传分片（CAS 命中时可省略 chunk 字段）
POST {{host}}/api/v1/upload/chunk
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=UploadBoundary

--UploadBoundary
Content-Disposition: form-data; name="id"

{{uploadId}}
--UploadBoundary
Content-Disposition: form-data; name="index"

0
--UploadBoundary
Content-Disposition: form-data; name="hash"

{{fileHash}}
--UploadBoundary
Content-Disposition: form-data; name="chunk"; filename="chunk-0.part"
Content-Type: application/octet-stream

< ./fixtures/chunk-0.bin
--UploadBoundary--

### POST /api/v1/upload/finalize — 完成上传（不合并落盘）
POST {{host}}/api/v1/upload/finalize
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "id": "{{uploadId}}"
}

### GET /api/v1/upload/progress/{id} — 查询上传进度
GET {{host}}/api/v1/upload/progress/{{uploadId}}
Authorization: Bearer {{token}}
Accept: application/json

### DELETE /api/v1/upload/cancel/{id} — 取消上传
DELETE {{host}}/api/v1/upload/cancel/{{uploadId}}
Authorization: Bearer {{token}}
Accept: application/json

### GET /api/v1/upload/files — 本人文件列表（分页）
GET {{host}}/api/v1/upload/files?page=1&size=20
Authorization: Bearer {{token}}
Accept: application/json

### GET /api/v1/upload/asset/{id} — 按资产 id 流式下载
GET {{host}}/api/v1/upload/asset/{{uploadId}}
Authorization: Bearer {{token}}
Accept: application/octet-stream

### GET /api/v1/upload/files/{hash} — 按 hash 流式下载
GET {{host}}/api/v1/upload/files/{{fileHash}}
Authorization: Bearer {{token}}
Accept: application/octet-stream
