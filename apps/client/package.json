{
  "name": "@i-thinking/client",
  "private": true,
  "type": "module",
  "version": "1.5.0",
  "scripts": {
    "build": "node scripts/build.ts",
    "build:core": "run-p type-check lint \"build-only {@}\" --",
    "build-only": "vite build",
    "check:cargo": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check:tauri": "pnpm run check:cargo",
    "dev": "tauri dev",
    "dev:core": "vite",
    "dev:tauri": "tauri dev",
    "lint": "eslint . --cache",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:unit": "vitest",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@i-thinking/chat": "workspace:*",
    "@i-thinking/design": "workspace:*",
    "@i-thinking/utils": "workspace:*",
    "@i-thinking/wasm": "workspace:*",
    "@iconify/json": "catalog:",
    "@iconify/react": "catalog:",
    "clsx": "catalog:",
    "go-captcha-react": "catalog:",
    "shaders": "catalog:",
    "swiper": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@i-thinking/shared": "workspace:*"
  }
}
