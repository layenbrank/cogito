{
  "name": "@cogito/client",
  "private": true,
  "type": "module",
  "version": "1.5.0",
  "scripts": {
    "build": "node scripts/build.ts",
    "build:core": "run-p type-check lint \"build-only {@}\" --",
    "build-only": "vite build",
    "check:cargo": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check:tauri": "pnpm run check:cargo",
    "coverage": "vitest run --coverage",
    "dev": "tauri dev",
    "dev:core": "vite",
    "dev:tauri": "tauri dev",
    "lint": "eslint . --cache",
    "migrate": "node scripts/migrate.ts",
    "migrate:down": "node scripts/migrate.ts down",
    "migrate:fresh": "node scripts/migrate.ts fresh",
    "migrate:status": "node scripts/migrate.ts status",
    "migrate:up": "node scripts/migrate.ts up",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:unit": "vitest",
    "type-check": "tsc --build",
    "unit": "vitest run"
  },
  "dependencies": {
    "@assistant-ui/react": "catalog:",
    "@cogito/chat": "workspace:*",
    "@cogito/design": "workspace:*",
    "@cogito/types": "workspace:*",
    "@cogito/utils": "workspace:*",
    "@cogito/wasm": "workspace:*",
    "@iconify/json": "catalog:",
    "@iconify/react": "catalog:",
    "@tiptap/extension-bubble-menu": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@types/d3": "^7.4.3",
    "@types/turndown": "^5.0.6",
    "@xterm/addon-fit": "catalog:",
    "@xterm/xterm": "catalog:",
    "assistant-stream": "catalog:",
    "clsx": "catalog:",
    "d3": "^7.9.0",
    "exifr": "^7.1.3",
    "go-captcha-react": "catalog:",
    "shaders": "catalog:",
    "swiper": "catalog:",
    "turndown": "^7.2.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cogito/shared": "workspace:*"
  }
}
