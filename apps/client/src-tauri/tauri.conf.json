{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "$APPLOCALDATA/**",
            "$APPDATA/**",
            "$APPCACHE/**",
            "$APPCONFIG/**",
            "$APPLOG/**",
            "$RESOURCE/**",
            "$TEMP/**"
          ]
        }
      },
      "csp": {
        "base-uri": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost https://asset.localhost blob: data: http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* wss://127.0.0.1:* ws://localhost:* wss://localhost:* https:",
        "default-src": "'self'",
        "font-src": "'self' data: asset: http://asset.localhost https://asset.localhost",
        "frame-src": "'self'",
        "img-src": "'self' blob: data: asset: http://asset.localhost https://asset.localhost https:",
        "media-src": "'self' blob: data: asset: http://asset.localhost https:",
        "object-src": "'none'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:"
      },
      "devCsp": {
        "base-uri": "*",
        "connect-src": "*",
        "default-src": "*",
        "font-src": "*",
        "form-action": "*",
        "frame-src": "*",
        "img-src": "*",
        "media-src": "*",
        "object-src": "*",
        "script-src": "*",
        "style-src": "*"
      },
      "headers": {
        "Access-Control-Allow-Credentials": "true",
        "Access-Control-Allow-Headers": "*",
        "Access-Control-Allow-Methods": "*",
        "Cross-Origin-Embedder-Policy": null,
        "Cross-Origin-Opener-Policy": null,
        "Cross-Origin-Resource-Policy": "cross-origin",
        "Timing-Allow-Origin": [
          "*",
          "https://*",
          "http://*",
          "https://developer.mozilla.org",
          "https://example.com"
        ]
      }
    },
    "windows": [
      {
        "backgroundColor": "#00000000",
        "center": true,
        "closable": true,
        "contentProtected": false,
        "create": true,
        "decorations": false,
        "devtools": true,
        "dragDropEnabled": true,
        "focus": false,
        "fullscreen": false,
        "height": 720,
        "label": "main",
        "maximizable": true,
        "minHeight": 600,
        "minWidth": 900,
        "resizable": true,
        "shadow": true,
        "skipTaskbar": false,
        "title": "cogito",
        "titleBarStyle": "Overlay",
        "transparent": true,
        "visible": true,
        "width": 1120,
        "windowEffects": {
          "effects": ["micaLight", "mica", "micaDark", "acrylic"]
        }
      },
      {
        "alwaysOnTop": true,
        "backgroundColor": "#00000000",
        "create": true,
        "decorations": false,
        "devtools": true,
        "dragDropEnabled": false,
        "focus": false,
        "fullscreen": false,
        "label": "overlay",
        "maximizable": true,
        "maximized": true,
        "minimizable": false,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "title": "Overlay",
        "transparent": true,
        "url": "/overlay",
        "visible": false
      }
    ],
    "withGlobalTauri": false
  },
  "build": {
    "beforeBuildCommand": "pnpm build:core",
    "beforeDevCommand": "pnpm dev:core",
    "devUrl": "http://localhost:8200",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/corex-daemon",
      "binaries/corex-mcp",
      "binaries/cogito-mcp",
      "binaries/goose"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      },
      "deb": {
        "files": {}
      },
      "rpm": {
        "epoch": 0,
        "files": {},
        "release": "1"
      }
    },
    "macOS": {
      "dmg": {
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "windowSize": {
          "height": 400,
          "width": 660
        }
      },
      "files": {},
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.13"
    },
    "publisher": "layen",
    "resources": {
      "icons/": "icons/",
      "binaries/pdfium.dll": "pdfium.dll"
    },
    "targets": "all",
    "windows": {
      "allowDowngrades": false,
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "nsis": {
        "compression": "lzma",
        "displayLanguageSelector": false,
        "installerHooks": "./nsis/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "startMenuFolder": "cogito"
      },
      "signCommand": null,
      "timestampUrl": "http://timestamp.digicert.com",
      "tsp": false,
      "webviewInstallMode": {
        "silent": true,
        "type": "offlineInstaller"
      },
      "wix": {
        "language": ["zh-CN", "en-US"]
      }
    }
  },
  "identifier": "com.cogito.client",
  "mainBinaryName": "cogito",
  "plugins": {
    "cli": {
      "description": "cogito desktop CLI",
      "args": [
        {
          "name": "minimized",
          "short": "m",
          "description": "Start hidden in the system tray"
        },
        {
          "name": "verbose",
          "short": "v",
          "description": "Enable verbose logging"
        }
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4RTQwMDZERTc1MTc2ODMKUldTRGRsSG5iUURrbUdJR2ZGRGxKTGN5ZWxBTWVoeVdWMVpmdXd3dnZrQTg2ZnkwU2dBaG12eUUK",
      "endpoints": [
        "https://pub-009a94d1a57d4e78ab66274c8ce48c60.r2.dev/updater-stable/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "productName": "cogito",
  "version": "1.5.0"
}
