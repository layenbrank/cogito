{
  "$schema": "../gen/schemas/desktop-schema.json",
  "description": "Capability for the main window（带 fs:scope 全盘读写：markdown / 代码工作区要打开用户任意目录，dialog 给的运行时授权重启后会丢）",
  "identifier": "default",
  "permissions": [
    "opener:allow-default-urls",
    "opener:allow-open-path",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir",
    "core:webview:default",
    {
      "allow": [
        {
          "app": "msedge",
          "url": "https://cn.bing.com"
        },
        {
          "app": "chrome",
          "url": "https://www.baidu.com"
        },
        {
          "app": true,
          "url": "https://*"
        },
        {
          "app": true,
          "url": "http://*"
        },
        {
          "url": "custom:*"
        },
        {
          "app": true,
          "url": "*"
        }
      ],
      "identifier": "opener:allow-open-url"
    },
    {
      "allow": [
        {
          "app": true,
          "url": "https://www.baidu.com"
        },
        {
          "app": "msedge",
          "url": "https://cn.bing.com"
        },
        {
          "app": true,
          "url": "https://*"
        },
        {
          "app": true,
          "url": "http://*"
        },
        {
          "app": true,
          "url": "*"
        }
      ],
      "identifier": "opener:allow-default-urls"
    },
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": ["**", "/**", "**/*"]
    },
    "core:webview:allow-clear-all-browsing-data",
    "core:webview:allow-webview-size",
    "core:path:default",
    "core:menu:default",
    "fs:allow-write",
    "fs:allow-watch",
    "fs:allow-write-file",
    "fs:allow-read",
    "fs:allow-read-dir",
    "fs:allow-document-read",
    "fs:allow-document-read-recursive",
    "fs:allow-document-write",
    "fs:allow-document-write-recursive",
    "fs:allow-read-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-write-text-file",
    "fs:allow-download-write",
    "fs:allow-download-write-recursive",
    "fs:allow-runtime-write",
    "fs:allow-runtime-write-recursive",
    "fs:allow-home-write",
    "fs:allow-home-write-recursive",
    "fs:allow-read-text-file",
    "fs:allow-read-text-file-lines",
    "fs:allow-runtime-read",
    "fs:allow-runtime-read-recursive",
    "core:webview:allow-create-webview",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-internal-toggle-devtools",
    "core:webview:allow-webview-close",
    "core:webview:allow-webview-show",
    "core:webview:allow-webview-hide",
    "core:webview:allow-get-all-webviews",
    "core:webview:allow-reparent",
    "core:webview:allow-set-webview-focus",
    "core:webview:deny-set-webview-zoom",
    "core:webview:deny-print",
    "core:webview:allow-set-webview-auto-resize",
    "core:webview:allow-set-webview-background-color",
    "core:window:allow-create",
    "core:window:allow-get-all-windows",
    "core:window:allow-center",
    "core:window:allow-is-maximizable",
    "core:window:allow-is-maximized",
    "core:window:allow-set-maximizable",
    "core:window:allow-set-max-size",
    "core:window:allow-is-decorated",
    "core:window:allow-is-always-on-top",
    "core:window:allow-set-always-on-top",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-unminimize",
    "core:window:allow-destroy",
    "websocket:allow-connect",
    "websocket:allow-send",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "dialog:allow-open",
    {
      "allow": [
        {
          "name": "binaries/corex-daemon",
          "sidecar": true
        },
        {
          "name": "binaries/goose",
          "sidecar": true
        }
      ],
      "identifier": "shell:allow-kill"
    },
    {
      "allow": [
        {
          "args": [],
          "cmd": "",
          "name": ""
        }
      ],
      "identifier": "shell:allow-open"
    },
    "shell:allow-execute",
    {
      "allow": [
        {
          "args": ["--pipe", "\\\\.\\pipe\\corex"],
          "name": "binaries/corex-daemon",
          "sidecar": true
        },
        {
          "args": [
            "serve",
            "--tls",
            "--platform",
            "desktop",
            "--enable-scheduler",
            "--host",
            "127.0.0.1",
            "--port",
            {
              "validator": "\\d+"
            }
          ],
          "name": "binaries/goose",
          "sidecar": true
        }
      ],
      "identifier": "shell:allow-spawn"
    },
    "shell:allow-stdin-write",
    "shell:allow-open",
    "store:allow-clear",
    "store:allow-delete",
    "store:allow-get",
    "store:allow-entries",
    "store:allow-get-store",
    "store:allow-has",
    "store:allow-keys",
    "store:allow-length",
    "store:allow-load",
    "store:allow-reload",
    "store:allow-reset",
    "store:allow-save",
    "store:allow-set",
    "store:allow-values",
    "process:allow-exit",
    "process:allow-restart",
    "positioner:allow-move-window",
    "positioner:allow-move-window-constrained",
    "positioner:allow-set-tray-icon-state",
    "notification:allow-batch",
    "notification:allow-cancel",
    "notification:allow-check-permissions",
    "notification:allow-create-channel",
    "notification:allow-delete-channel",
    "notification:allow-get-active",
    "notification:allow-get-pending",
    "notification:allow-is-permission-granted",
    "notification:allow-list-channels",
    "notification:allow-notify",
    "notification:allow-permission-state",
    "notification:allow-register-action-types",
    "notification:allow-register-listener",
    "notification:allow-remove-active",
    "notification:allow-request-permission",
    "notification:allow-show",
    "clipboard-manager:default",
    "log:allow-log",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "clipboard-manager:allow-clear",
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-html",
    "clipboard-manager:allow-write-image",
    "clipboard-manager:allow-write-text",
    "core:event:allow-emit",
    "core:event:allow-emit-to",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:image:allow-from-bytes",
    "core:image:allow-from-path",
    "core:image:allow-new",
    "core:image:allow-rgba",
    "core:image:allow-size",
    "cli:default",
    "core:app:allow-app-hide",
    "core:app:allow-app-show",
    "core:app:allow-set-app-theme",
    "core:app:allow-register-listener",
    "core:app:allow-set-dock-visibility",
    "core:window:allow-set-position",
    "core:window:allow-current-monitor",
    "core:window:allow-cursor-position",
    "core:window:allow-set-decorations",
    "core:window:allow-available-monitors",
    "core:window:allow-inner-position",
    "core:window:allow-inner-size",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-closable",
    "core:window:allow-is-enabled",
    "core:window:allow-is-focused",
    "core:window:allow-is-fullscreen",
    "core:window:allow-is-minimizable",
    "core:window:allow-is-minimized",
    "core:window:allow-is-resizable",
    "core:window:allow-is-visible",
    "core:window:allow-monitor-from-point",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-primary-monitor",
    "core:window:allow-request-user-attention",
    "core:window:allow-scale-factor",
    "core:window:allow-set-always-on-bottom",
    "core:window:allow-set-background-color",
    "core:window:allow-set-badge-count",
    "core:window:allow-set-badge-label",
    "core:window:allow-set-closable",
    "core:window:allow-set-content-protected",
    "core:window:allow-set-cursor-grab",
    "core:window:allow-set-cursor-icon",
    "core:window:allow-set-cursor-position",
    "core:window:allow-set-cursor-visible",
    "core:window:allow-set-effects",
    "core:window:allow-set-enabled",
    "core:window:allow-set-focusable",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-icon",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-set-min-size",
    "core:window:allow-set-minimizable",
    "core:window:allow-set-overlay-icon",
    "core:window:allow-set-progress-bar",
    "core:window:allow-set-resizable",
    "core:window:allow-set-shadow",
    "core:window:allow-set-simple-fullscreen",
    "core:window:allow-set-size",
    "core:window:allow-set-size-constraints",
    "core:window:allow-set-skip-taskbar",
    "core:window:allow-set-theme",
    "core:window:allow-set-title",
    "core:window:allow-set-title-bar-style",
    "core:window:allow-set-visible-on-all-workspaces",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-theme",
    "core:window:allow-title",
    "core:webview:allow-set-webview-position",
    "core:webview:allow-set-webview-size",
    "core:webview:allow-set-webview-zoom",
    "core:webview:allow-webview-position",
    "core:window:allow-toggle-maximize",
    "global-shortcut:allow-register-all",
    "global-shortcut:allow-unregister-all",
    {
      "allow": [
        {
          "url": "http://**"
        },
        {
          "url": "https://**"
        },
        {
          "url": "http://*:*"
        },
        {
          "url": "https://*:*"
        }
      ],
      "identifier": "http:allow-fetch-send"
    },
    {
      "allow": [
        {
          "url": "http://**"
        },
        {
          "url": "https://**"
        },
        {
          "url": "http://*:*"
        },
        {
          "url": "https://*:*"
        }
      ],
      "identifier": "http:allow-fetch-read-body"
    },
    {
      "allow": [
        {
          "url": "http://**"
        },
        {
          "url": "https://**"
        },
        {
          "url": "http://*:*"
        },
        {
          "url": "https://*:*"
        }
      ],
      "identifier": "http:allow-fetch-cancel"
    },
    {
      "allow": [
        {
          "url": "http://**"
        },
        {
          "url": "https://**"
        },
        {
          "url": "http://*:*"
        },
        {
          "url": "https://*:*"
        }
      ],
      "identifier": "http:allow-fetch"
    },
    {
      "allow": [
        {
          "url": "https://*.tauri.app"
        },
        {
          "url": "https://private.tauri.app"
        },
        {
          "url": "http://**"
        },
        {
          "url": "https://**"
        },
        {
          "url": "http://*:*"
        },
        {
          "url": "https://*:*"
        }
      ],
      "identifier": "http:default"
    },
    "updater:default"
  ],
  "platforms": ["macOS", "linux", "windows"],
  "remote": {
    "urls": [
      "http://*",
      "https://*",
      "http://localhost:*",
      "https://www.baidu.com",
      "https://*.baidu.com",
      "https://cn.bing.com",
      "https://*.bing.com",
      "https://www.youku.com",
      "https://*.youku.com",
      "https://game.weixin.qq.com",
      "https://*.weixin.qq.com"
    ]
  },
  "windows": ["main", "overlay", "navigation", "navigation-bar", "*:*"]
}
