# 打包版后端：Cloudflare Tunnel 暴露的正式服务（本机 127.0.0.1:3000 → api.cogito-corex.cn）。
# 必须带 `/api/v1`：`utils/http/env.ts` 直接把它当 ofetch 的 baseURL，
# 而 `utils/http/media.ts` 只取它的 origin 再拼服务端回的 `/api/v1/...` 相对路径。
VITE_COGITO = "https://api.cogito-corex.cn/api/v1"
VITE_ENGINE = "/bing"
VITE_INTELLIGENCE = "http://localhost:11434/api"