# 注入 cogito 容器的 COGITO__*（compose environment 优先级更高）。不入库。
# 说明：guide/deployment.md §2 · 生产清单 §3.3
#
#   cp docker/stack.env.example docker/stack.env

# ── 生产必填（占位值会被 validate() 拒启）────────────────────────────────────
# COGITO__SECURITY__SECRET=
# COGITO__SECURITY__JWT_SECRET=          # ≥32 字符，openssl rand -base64 48
# COGITO__EVENTS__ENDPOINT=https://events.example.com/v1/ingest
# COGITO__EVENTS__TOKEN=

# ── 跨域（精确匹配；开发可用 *）──────────────────────────────────────────────
# COGITO__CORS__ORIGINS=*
# COGITO__CORS__ORIGINS=http://localhost:9523,http://localhost:1024

# ── 平台 ADMIN（生产必须真密码；开发默认见 config.development.yaml）──────────
# COGITO__AUTH__BOOTSTRAP_ADMIN__USERNAME=admin
# COGITO__AUTH__BOOTSTRAP_ADMIN__PASSWORD=
# COGITO__AUTH__BOOTSTRAP_ADMIN__SYNC_PASSWORD=true

# ── 可选──────────────────────────────────────────────────────────────────────
# COGITO__LOGGING__FILTER=info
# COGITO__LOGGING__FORMAT=json
# COGITO__TELEMETRY__ENABLED=false
# COGITO__TELEMETRY__SAMPLE_RATIO=0.1
