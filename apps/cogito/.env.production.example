# 生产 compose 插值。不入库。完整说明：guide/deployment.md §3
#
#   cp .env.production.example .env.production
#   cp docker/stack.env.example docker/stack.env   # 安全密钥与 events.endpoint

# 必填：openssl rand -base64 36
POSTGRES_PASSWORD=
AI_WORKER_INTERNAL_TOKEN=
SERVICE_TOKEN_SECRET=

APP_ENV=production
AI_WORKER_ENVIRONMENT=production
TELEMETRY_ENABLED=false
# OTLP_ENDPOINT=http://jaeger:4318

# 必填镜像（本机验产用 local；真部署改 registry 后先 pull 再 up）
COGITO_IMAGE=cogito:local
AI_WORKER_IMAGE=cogito-ai-worker:local
POSTGRES_IMAGE=cogito-postgres:18-zh-pgvector

# COGITO_API_PORT=3000
