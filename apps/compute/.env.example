# compute 配置样例。`cp .env.example .env` 后按需修改；
# 字段名 → 环境变量：`internal_token` → `COMPUTE_INTERNAL_TOKEN`（前缀固定，大小写不敏感）。
# 真实值只写进 .env / 部署密钥，不要提交（.env 已在 .gitignore 里）。

# development | test | production
COMPUTE_ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
COMPUTE_LOG_LEVEL=INFO

# 只监听内网地址：外部可达时 X-Internal-Token 就是一把暴露在公网的共享密钥。
COMPUTE_HOST=127.0.0.1
COMPUTE_PORT=8081

# ── 必填（缺失即启动失败，没有默认值）────────────────────────────────────────
# cogito 配置里的 `compute.token`，即请求头 X-Internal-Token 的值。
# 这是 cogito 与 compute 之间唯一的共享密钥；建议 ≥ 32 字符，短了会打 WARNING。
# 注意：它是 cogito 的 `compute.token`，**不是** `gateway.service_token_secret`。
COMPUTE_INTERNAL_TOKEN=change-me-to-a-32-plus-character-random-string
# 必须是 compute 自己的库（跑完迁移后里面只会有 schema_migration / idempotency_key 两张表），
# 不能指向 cogito 的业务库（tests/test_db_boundary.py 会把这条边界钉死）。
COMPUTE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55433/compute_test
# cogito 的基址，不带尾斜杠；只用来换取服务令牌、读资产正文、请求嵌入算力。
# 端口要跟 cogito 配置里的 `server.port` 对上（仓库默认 3000，不是 8080——8080 是 gocaptcha 侧车）。
COMPUTE_COGITO_BASE_URL=http://127.0.0.1:3000

# ── 出站调用（可选）────────────────────────────────────────────────────────
# 单次请求超时（秒）。
COMPUTE_COGITO_TIMEOUT_SECONDS=30
# 服务令牌提前多少秒续签，避免「刚好在过期那一瞬间发出请求」。
COMPUTE_COGITO_TOKEN_REFRESH_SKEW_SECONDS=30
# 回打 cogito 时是否让系统/环境变量代理接管。默认 false = 直连：cogito 是内网端点，而 httpx 在
# Windows 上会连**注册表里的系统代理**一起读，本机代理软件会把 127.0.0.1:3000 一起接走，
# 症状是 502 且响应体为空、cogito 侧连一条访问记录都没有（对应 cogito 的 compute.use_system_proxy）。
COMPUTE_COGITO_USE_SYSTEM_PROXY=false
# 申请服务令牌时希望的有效期（秒）；留空 = 用 cogito 的默认值（cogito 侧收敛到上限 3600）。
# 不能写成 `COMPUTE_COGITO_SERVICE_TOKEN_TTL_SECONDS=`（空串不是合法的整数，会启动失败），要留空就整行注释掉。
# COMPUTE_COGITO_SERVICE_TOKEN_TTL_SECONDS=1800
# 单个资产正文的大小上限（字节）；超过判为不可重试的请求问题（400），不落库。
COMPUTE_ASSET_MAX_BYTES=67108864
# 幂等键停留在「进行中」超过多久即可被后来的请求接管（秒）。
COMPUTE_IDEMPOTENCY_STALE_SECONDS=900

# ── 分块（可选）────────────────────────────────────────────────────────────
# 请求体里省略 chunkSize / chunkOverlap 时用的目标值：块大小（字符）与块间重叠（字符）。
# 重叠必须严格小于块大小，否则启动失败。单个块的实际长度可能略超 chunkSize（为了不切断句子）。
COMPUTE_DEFAULT_CHUNK_SIZE=1200
COMPUTE_DEFAULT_CHUNK_OVERLAP=200

# ── 嵌入（可选）────────────────────────────────────────────────────────────
# 一次 POST /service/embeddings 里塞多少个块。分小批是为了：单次响应别太大、
# 上游超时别拖垮整个区间（已经算好的批会先落库，重试时只补缺）。
COMPUTE_EMBED_BATCH_SIZE=64

# ── agent 运行时（可选）────────────────────────────────────────────────────
# 单步里最多真正执行几次工具调用；超出的调用不执行、只回一条失败结果，让模型下一轮再补
# （串行跑十个工具会让这一步的耗时不可预测，而 cogito 的活动超时是固定的）。
COMPUTE_AGENT_MAX_TOOL_CALLS_PER_STEP=8
# 单条工具结果喂回模型前的字符上限：检索一次可能命中几十块，不截断会撑爆上下文。
COMPUTE_AGENT_TOOL_RESULT_MAX_CHARS=8000
# 每步允许模型写几次长期记忆（同一个内容重复写只落一行，不额外计一次）。0 即关闭
# `memory_write` 工具；任务收尾的结论摘要由 cogito 的编排直接写，不受这个开关约束。
COMPUTE_AGENT_MEMORY_MAX_WRITES_PER_STEP=2

# ── 数据库（可选）──────────────────────────────────────────────────────────
COMPUTE_DB_POOL_MIN_SIZE=1
COMPUTE_DB_POOL_MAX_SIZE=10
COMPUTE_DB_CONNECT_TIMEOUT_SECONDS=5
COMPUTE_DB_COMMAND_TIMEOUT_SECONDS=60
# 库不可用时的降级行为：服务照常起来并回 503 degraded，探针按这个间隔重试重连（秒）。
COMPUTE_DB_RECONNECT_INTERVAL_SECONDS=5

# ── 链路追踪（可选，默认关闭）──────────────────────────────────────────────
# 关闭时进程里不注册任何 OTel 全局状态、不联网；跨进程仍靠内置的 W3C 实现透传 traceparent
# （见 src/compute/trace.py），行为与接入前逐字一致。
COMPUTE_TELEMETRY_ENABLED=false
# OTLP/HTTP 基址：不带路径时自动补 /v1/traces，带路径则原样使用（与 cogito 同规则）。
# 本地 Jaeger 的 OTLP 端口是 4318，UI 在 16686。
COMPUTE_TELEMETRY_ENDPOINT=http://127.0.0.1:4318
# 资源里的 service.name：后端按它筛服务，不能为空。
COMPUTE_TELEMETRY_SERVICE_NAME=cogito-compute
# 采样比例 0.0–1.0；上游已带采样决定时跟随上游（ParentBased），只有根 span 才掷骰子。
COMPUTE_TELEMETRY_SAMPLE_RATIO=1.0
# 单次导出超时（毫秒）。
COMPUTE_TELEMETRY_TIMEOUT_MS=10000
